# KRATOS Core — variáveis de ambiente (copie para .env)

# Nome exibido do app
APP_NAME=KRATOS Core

# Controle de acesso por convite (kill-switch). off | on
ACCESS_CONTROL=off

# Chave-mestra do admin (gera/revoga convites; entra sem convite).
# Gere uma forte, ex.: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=


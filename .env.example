# KRATOS — exemplo de variáveis de ambiente (.env). NÃO comitar o .env real.

# --- Núcleo / AIS ---
PORT=8080
AIS_MODE=mock                 # mock | live
AISSTREAM_API_KEY=
DEFAULT_AREA=rio
DASHBOARD_USER_ID=default

# --- Praticagem-RJ ---
PRATICAGEM_RJ_URL=
PRATICAGEM_AUTO_SYNC_SECONDS=60

# --- Assistente KRATOS (xAI) ---
XAI_API_KEY=
XAI_MODEL=
ASSISTANT_PROFILE=

# --- Integração Obsidian via Supabase Storage (Sprint 1) ---
# Backend (cPanel) usa a REST API de Storage: precisa de URL + KEY + BUCKET.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=                 # service_role (ou chave com escrita em Storage). Server-side, manter secreta.
SUPABASE_BUCKET=kratos-vault  # bucket PRIVADO
OBSIDIAN_NOTE_PREFIX=kratos   # pasta das notas geradas (separada das notas livres do usuário)
OBSIDIAN_AUTO_SYNC=0          # 1 = exporta automaticamente (loop + após sync da Praticagem)
OBSIDIAN_AUTO_SYNC_SECONDS=300 # intervalo/debounce do export automático (s). Evita upload a cada posição AIS.

# Chaves S3 — usadas pelo plugin Remotely Save no OBSIDIAN, não pelo backend.
# Documentadas aqui para o tutorial de configuração.
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
